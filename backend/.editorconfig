root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{cs,csx}]
indent_size = 4
csharp_indent_case_contents = true
csharp_indent_switch_labels = true

# Las migraciones las genera dotnet ef (con BOM): no se formatean a mano.
[src/Tato.Infrastructure/Persistencia/Migraciones/*.cs]
generated_code = true
