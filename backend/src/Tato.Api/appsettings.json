{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Almacenamiento": {
    "Disco": {
      "CarpetaRaiz": "archivos"
    }
  },
  "Fotos": {
    "MaxBytes": 20971520,
    "MaxPixeles": 50000000,
    "LadoMiniatura": 400,
    "LadoGaleria": 1080,
    "LadoDetalle": 2048,
    "CalidadWebp": 80
  },
  "Sitio": {
    "SegundosCacheDatos": 60,
    "SegundosCacheFotos": 3600,
    "LargoExtracto": 200
  }
}
